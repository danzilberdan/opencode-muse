{
  "name": "opencode-muse",
  "version": "0.1.0",
  "description": "OpenCode plugin that brings the official Muse Code subscription (OAuth device flow, like the muse CLI) to opencode as an OpenAI-compatible provider.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "muse",
    "meta",
    "oauth",
    "device-flow",
    "reasoning-effort"
  ],
  "dependencies": {
    "@opencode/plugin": "2.0.22"
  },
  "engines": {
    "opencode": ">=2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/muse.js --log-level=warning"
  }
}
